# Copy this file to .env and fill in real values.

# MySQL connection (matches the schema in schema.sql)
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/staysense_phitsanulok

# Comma-separated list of allowed origins for the Vue frontend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT auth
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Semantic search
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
