# Copy to .env for local dev, or set these as environment variables in your
# hosting platform (Railway "Variables" tab). See DEPLOY.md for the full guide.

# Railway's MySQL plugin gives you a connection string that looks like
# mysql://user:pass@host:port/railway — SQLAlchemy needs the pymysql driver
# named explicitly, so change "mysql://" to "mysql+pymysql://".
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/staysense_phitsanulok

# Comma-separated list of frontend origins allowed to call this API.
# Add your Vercel URL here once you have it (both the *.vercel.app preview
# domain and any custom domain), e.g.:
# CORS_ORIGINS=http://localhost:5173,https://staysense-phitsanulok.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Generate a real random value for production — never reuse the dev default.
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Semantic search embedding model (downloaded on first boot)
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small

# The public URL this backend itself is reachable at (used to build links to
# uploaded images). Set to your Railway backend URL once deployed.
PUBLIC_BASE_URL=http://localhost:8000
