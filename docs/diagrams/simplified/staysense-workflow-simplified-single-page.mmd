%%{init: {"flowchart": {"htmlLabels": true, "curve": "basis"}, "theme": "base", "themeVariables": {"fontSize": "14px"}} }%%
flowchart TD

Start((Start)):::startend
Access[/Access StaySense Phitsanulok Website/]:::guest
SelectType{Select User Type}:::decisionNode
GuestMode[Guest Mode: Browse Without Login]:::guest
End((End)):::startend

Start --> Access --> SelectType
SelectType -->|Guest| GuestMode --> EnterQuery
SelectType -->|Registered User| EnterCred
SelectType -->|Administrator| EnterCred
GuestMode -.->|Register| RegStart

%% =========================================================
%% Semantic Search and Accommodation Details
%% =========================================================
EnterQuery[/Enter Natural-Language Query and Search Filters/]:::guest
SubmitSearch[Submit Search]:::guest
ValidateInput{Search Input Valid?}:::decisionNode
InputError[Display Input Error Message]:::errorNode
SemanticProcess[[Convert Query to Vector, Calculate Semantic Similarity, Apply Filters and Rank Results]]:::semantic
HasResults{Matching Accommodation Found?}:::decisionNode
NoResults[Display 'No Matching Accommodation Found']:::errorNode
DisplayResults[/Display Search Results/]:::guest
ViewDetails[/View Accommodation Details/]:::guest
ViewMap[View Location on Map]:::guest
ShareInfo[Share Accommodation Information]:::guest
CheckLogin{Registered User Logged In?}:::decisionNode
FinishViewing[Finish Viewing Information]:::guest

EnterQuery --> SubmitSearch --> ValidateInput
ValidateInput -->|No| InputError --> EnterQuery
ValidateInput -->|Yes| SemanticProcess --> HasResults
HasResults -->|No| NoResults --> EnterQuery
HasResults -->|Yes| DisplayResults --> ViewDetails
ViewDetails --> ViewMap --> FinishViewing --> End
ViewDetails --> ShareInfo --> FinishViewing
ViewDetails --> CheckLogin
CheckLogin -->|No| EnterCred

%% =========================================================
%% Registered User Functions
%% =========================================================
subgraph MEMBER["Registered User Functions"]
    direction TB
    Favorites[Save and Manage Favorites]:::member
    History[View Search History and Recently Viewed]:::member
    Compare[Compare Selected Accommodations]:::member
    Recommend[View Personalized Recommendations]:::member
    Profile[Manage Personal Information]:::member
    LogoutR[Logout]:::member
end

CheckLogin -->|Yes| Favorites
CheckLogin -->|Yes| History
CheckLogin -->|Yes| Compare
CheckLogin -->|Yes| Recommend
CheckLogin -->|Yes| Profile
Favorites --> LogoutR
History --> LogoutR
Compare --> LogoutR
Recommend --> LogoutR
Profile --> LogoutR
LogoutR --> End

%% =========================================================
%% Member Registration
%% =========================================================
subgraph REGISTER["Member Registration"]
    direction TB
    RegStart[Register]:::guest
    EnterAccountInfo[/Enter Account Information/]:::guest
    AccountExists{Account Already Exists?}:::decisionNode
    DupMsg[Display Duplicate Account Message]:::errorNode
    CreateAccount[(Create and Store User Account)]:::database
    RegSuccess[Registration Successful]:::authNode
end

RegStart --> EnterAccountInfo --> AccountExists
AccountExists -->|Yes| DupMsg --> EnterAccountInfo
AccountExists -->|No| CreateAccount --> RegSuccess --> EnterCred

%% =========================================================
%% Login and Authentication
%% =========================================================
subgraph AUTH["Login and Authentication"]
    direction TB
    EnterCred[/Enter Username and Password/]:::authNode
    AuthSuccess{Authentication Successful?}:::decisionNode
    LoginError[Display Login Error]:::errorNode
    CheckRole{Check User Role}:::decisionNode
end

EnterCred --> AuthSuccess
AuthSuccess -->|No| LoginError --> EnterCred
AuthSuccess -->|Yes| CheckRole
CheckRole -->|Registered User| EnterQuery
CheckRole -->|Administrator| CheckPermission

%% =========================================================
%% Administrator Data Management
%% =========================================================
CheckPermission{Check Administrator Permission}:::decisionNode
AccessDenied[Display Access Denied Message]:::errorNode
AdminDash[Open Administrator Dashboard]:::admin
SelectMgmt{Select Management Function}:::decisionNode

CheckPermission -->|Denied| AccessDenied --> End
CheckPermission -->|Granted| AdminDash --> SelectMgmt

subgraph CRUD["Manage Accommodation Data"]
    direction TB
    ManageAccom[Add / Edit Accommodation Information]:::admin
    ValidateInfo{Information Valid?}:::decisionNode
    ValidationMsg[Display Validation Message]:::errorNode
    SaveDB[(Save to MySQL Database)]:::database
    UpdateVector[[Update Semantic Search Vector]]:::semantic
    PublishAccom[Publish / Update Accommodation]:::admin

    DeleteAccom[Delete or Unpublish Accommodation]:::admin
    ConfirmDelete{Confirm Action?}:::decisionNode
    RemoveVector[(Update Database and Remove Semantic Vector)]:::database
end

SelectMgmt --> ManageAccom --> ValidateInfo
ValidateInfo -->|No| ValidationMsg --> ManageAccom
ValidateInfo -->|Yes| SaveDB --> UpdateVector --> PublishAccom --> FinishMgmt

SelectMgmt --> DeleteAccom --> ConfirmDelete
ConfirmDelete -->|No| DeleteAccom
ConfirmDelete -->|Yes| RemoveVector --> FinishMgmt

VerifyData[Review and Verify Data Quality from Multiple Sources]:::admin
SaveVerified[(Save Verified Information)]:::database
SelectMgmt --> VerifyData --> SaveVerified --> FinishMgmt

ManageOther[Manage Supporting Data: Types, Room Types, Amenities, Images, Locations, Data Sources, Users]:::admin
SelectMgmt --> ManageOther --> FinishMgmt

FinishMgmt[Finish Data Management]:::admin
LogoutA[Logout]:::admin
FinishMgmt --> LogoutA --> End

