%% =========================================================
%% Semantic Search Subprocess (shared by Guest and Registered User)
%% =========================================================
subgraph SEARCH["Semantic Search Workflow"]
    direction TB
    EnterQuery[/Enter Natural-Language Query/]:::guest
    SelectFilters[/Select Search Filters: Type, District, Price, Guests, Amenities, Atmosphere/]:::guest
    UseLocation[/Use Current Location - Optional/]:::guest
    SubmitSearch[Submit Search]:::guest
    ValidateInput{Validate Search Input}:::decisionNode
    InputError[Display Search Input Error Message]:::errorNode
    SendAPI[Send Query to Back-end API]:::semantic
    QueryPrep[[Query Preprocessing]]:::semantic
    ConvertVector[[Convert Query to Vector - Embedding]]:::semantic
    RetrieveVectors[(Retrieve Accommodation Vectors)]:::database
    CalcSimilarity[[Calculate Semantic Similarity]]:::semantic
    ApplyFilters[[Apply Search Filters]]:::semantic
    RankResults[[Rank Search Results by Relevance]]:::semantic
    ReturnResults[Return Search Results]:::semantic
    HasResults{Matching Accommodation Found?}:::decisionNode
    NoResults[Display 'No Matching Accommodation Found']:::errorNode
    DisplayResults[/Display Search Results/]:::guest
end

EnterQuery --> SelectFilters --> UseLocation --> SubmitSearch --> ValidateInput
ValidateInput -->|No| InputError --> EnterQuery
ValidateInput -->|Yes| SendAPI --> QueryPrep --> ConvertVector --> RetrieveVectors --> CalcSimilarity --> ApplyFilters --> RankResults --> ReturnResults --> HasResults
HasResults -->|No| NoResults --> EnterQuery
HasResults -->|Yes| DisplayResults

GuestMode --> EnterQuery
MemberDash --> EnterQuery

