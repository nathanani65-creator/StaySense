%% =========================================================
%% Registration Workflow
%% =========================================================
subgraph REGISTER["Member Registration Workflow"]
    direction TB
    RegStart[Register]:::guest
    EnterAccountInfo[/Enter Account Information/]:::guest
    ValidateAccount[Validate Account Information]:::authNode
    AccountExists{Account Already Exists?}:::decisionNode
